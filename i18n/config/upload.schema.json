{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./upload.schema.json",
  "title": "MyPRAxIS Translation Upload Payload",
  "description": "Editor-facing upload payload processed by i18n/bin/process-upload.js before changes are merged into i18n/source/translations.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "version": {
      "type": ["number", "string"]
    },
    "source": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Optional existing translation key. If present, the upload is treated as a direct update candidate. Locale fields that are present, including explicit empty strings, are applied to the existing entry."
          },
          "nl": {
            "type": "string"
          },
          "fr": {
            "type": "string"
          },
          "en": {
            "type": "string"
          },
          "status": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional per-locale review status. Use review-required to mark a locale for review, approved to clear it.",
            "properties": {
              "nl": {
                "type": "string",
                "enum": ["approved", "review-required"]
              },
              "fr": {
                "type": "string",
                "enum": ["approved", "review-required"]
              },
              "en": {
                "type": "string",
                "enum": ["approved", "review-required"]
              }
            }
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "requestedNamespace": {
            "type": "string",
            "minLength": 1,
            "description": "Optional namespace/category requested by the submitting client for new translation proposals."
          }
        }
      }
    }
  }
}
