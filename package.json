{
  "name": "mypraxis_translation_keys",
  "private": true,
  "scripts": {
    "translations:build": "node i18n/bin/build-translations.js",
    "translations:check": "node i18n/bin/build-translations.js --check",
    "translations:help": "node i18n/bin/build-translations.js --help",
    "translations:list-namespaces": "node i18n/bin/build-translations.js --list-namespaces",
    "translations:report": "node i18n/bin/build-translations.js --report",
    "translations:validate": "node i18n/bin/build-translations.js --validate",
    "uploads:prepare": "node i18n/bin/process-upload.js prepare",
    "uploads:apply-proposals": "node i18n/bin/process-upload.js apply-proposals",
    "uploads:route": "node i18n/bin/route-upload-batches.js",
    "uploads:process-inbox": "node i18n/bin/process-upload-inbox.js",
    "update": "sh ./scripts/update-translations.sh"
  }
}
